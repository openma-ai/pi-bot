{
  "enabled": true,
  "network": {
    "allowedDomains": ["github.com", "*.github.com", "raw.githubusercontent.com", "npmjs.org", "*.npmjs.org", "registry.npmjs.org", "registry.yarnpkg.com", "pypi.org", "*.pypi.org"],
    "deniedDomains": []
  },
  "filesystem": {
    "denyRead": ["~/.ssh", "~/.aws", "~/.gnupg", "~/.pi/agent/auth.json", "~/.pi/agent/models.json"],
    "allowWrite": [".", "/tmp"],
    "denyWrite": [".env", ".env.*", "*.pem", "*.key"]
  }
}
