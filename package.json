{
  "name": "pi-bot",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Persistent non-preemptive multi-bot runtime built on Pi",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node scripts/apply-pi-background-bridge.mjs && node --import tsx --test test/*.test.ts",
    "test:layers": "node --import tsx --test test/layers.test.ts",
    "prepare:background": "node scripts/apply-pi-background-bridge.mjs",
    "test:background": "node scripts/apply-pi-background-bridge.mjs && node --import tsx --test test/background-*.test.ts test/pi-background-bridge.test.ts",
    "smoke:background": "node --import tsx examples/background-smoke.ts",
    "start": "node --import tsx src/daemon/main.ts chat",
    "daemon": "node --import tsx src/daemon/main.ts daemon",
    "client": "node --import tsx src/daemon/main.ts client",
    "gui:build": "vite build src/gui --outDir ../../dist/gui --emptyOutDir",
    "gui": "npm run gui:build && npm run client",
    "credential-entry": "node --import tsx src/daemon/credential-cli.ts",
    "messages:query": "node --import tsx src/evals/channel-messages-cli.ts",
    "demo": "node --import tsx src/evals/demo.ts",
    "evaluate": "node --import tsx src/evals/evaluation-cli.ts",
    "evaluate:behavior": "node --import tsx src/evals/behavior-cli.ts",
    "benchmark:proactive": "node --import tsx src/evals/proactive-benchmark-cli.ts",
    "format": "node scripts/format.mjs",
    "pi-bot": "node --import tsx src/daemon/main.ts",
    "protocol:schema": "node --import tsx scripts/protocol-schema.mjs",
    "smoke:app-server": "node --import tsx src/evals/app-server-smoke.ts",
    "benchmark:engineering": "node --import tsx src/evals/complex-repo-cli.ts",
    "gui:check": "eslint src/gui"
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "0.0.26",
    "@earendil-works/pi-agent-core": "1.1.0",
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@novnc/novnc": "1.7.0",
    "@openma/matter": "^0.2.1",
    "@radix-ui/themes": "^3.2.1",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "effect": "^3.22.1",
    "lucide-react": "^0.468.0",
    "pi-chrome-use": "1.1.1",
    "pi-subagents": "0.77.0",
    "radix-ui": "^1.4.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "typebox": "1.3.27",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "22.19.15",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "8.18.1",
    "eslint": "^9.39.4",
    "globals": "^17.13.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "^8.3.4"
  }
}
