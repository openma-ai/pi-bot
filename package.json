{
  "name": "pi-bot",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Persistent non-preemptive multi-bot runtime built on Pi",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "demo": "node --import tsx src/demo.ts",
    "start": "node --import tsx src/cli.ts",
    "format": "node scripts/format.mjs",
    "evaluate": "node --import tsx src/evaluation-cli.ts",
    "credential-entry": "node --import tsx src/credential-cli.ts"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-agent-core": "1.1.0",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@types/node": "22.19.15",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
