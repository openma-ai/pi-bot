+
+/// pi-bot patch: pin the server to one CGDirectDisplayID (MAC_VNC_DISPLAY_ID) so the
+/// 1-based index does not drift when other per-bot virtual displays come and go.
+enum PiBotDisplayPin {
+    static let pinnedID: CGDirectDisplayID? = ProcessInfo.processInfo.environment["MAC_VNC_DISPLAY_ID"].flatMap { UInt32($0) }
+
+    static func resolve(_ displays: [VirtualDisplay], _ displayIndex: Int) -> VirtualDisplay? {
+        if let pinnedID { return displays.first { $0.id == pinnedID } }
+        guard displays.indices.contains(displayIndex - 1) else { return nil }
+        return displays[displayIndex - 1]
+    }
+}
+
+/// pi-bot patch: view-only by default when MAC_VNC_VIEW_ONLY=1; the daemon writes
+/// "interactive" into MAC_VNC_CONTROL_FILE during a human takeover (x11vnc -R noviewonly analogue).
+enum PiBotViewOnly {
+    static let enabled = ProcessInfo.processInfo.environment["MAC_VNC_VIEW_ONLY"] == "1"
+    static let controlFile = ProcessInfo.processInfo.environment["MAC_VNC_CONTROL_FILE"]
+
+    static var dropInput: Bool {
+        guard enabled else { return false }
+        guard let controlFile, let text = try? String(contentsOfFile: controlFile, encoding: .utf8) else { return true }
+        return text.trimmingCharacters(in: .whitespacesAndNewlines) != "interactive"
+    }
+}
